# ---- shared ----
NODE_ENV=development

# ---- database (api + worker share) ----
DATABASE_URL=postgresql://abdcshare:abdcshare@localhost:5432/abdcshare

# ---- redis / bullmq ----
REDIS_URL=redis://localhost:6379

# ---- api ----
API_PORT=4000
API_GLOBAL_PREFIX=api
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

# ---- storage (api: copy into apps/api/.env) ----
# local = dev fallback via API /storage/local; r2 = Cloudflare R2 presigned URLs
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000
STORAGE_UPLOAD_TTL=900
LOCAL_STORAGE_DIR=./storage
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_OBJECT_PREFIX=abdcshare

# ---- email (worker: copy into apps/worker/.env) ----
RESEND_API_KEY=
EMAIL_FROM="ABDC Share <no-reply@example.com>"
WEB_APP_URL=http://localhost:3000

# ---- web ----
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
