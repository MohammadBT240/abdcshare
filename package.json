{
  "name": "abdcshare",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "dev:api": "pnpm --filter @abdcshare/api dev",
    "dev:worker": "pnpm --filter @abdcshare/worker dev",
    "dev:web": "pnpm --filter @abdcshare/web dev"
  },
  "devDependencies": {
    "turbo": "^2.10.5",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3"
  }
}
