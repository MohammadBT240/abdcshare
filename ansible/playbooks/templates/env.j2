# Managed by Ansible — do not edit on the server.
# {{ ansible_managed }}
{% if compose_project_name | default('') | length > 0 %}
COMPOSE_PROJECT_NAME={{ compose_project_name | to_json }}
{% endif %}
REGISTRY_OWNER={{ registry_owner | to_json }}
IMAGE_TAG={{ image_tag | default(image_tag_default | default('latest')) | to_json }}

API_HOST_PORT={{ api_host_port | default(4100) }}
WEB_HOST_PORT={{ web_host_port | default(3100) }}

POSTGRES_PASSWORD={{ vault_postgres_password | to_json }}
{# DATABASE_URL userinfo must be URL-encoded so / + = @ etc. do not break parsing #}
{% set _db_pw = vault_postgres_password | replace('%', '%25') | urlencode | replace('/', '%2F') %}
DATABASE_URL={{ ('postgresql://abdcshare:' ~ _db_pw ~ '@postgres:5432/abdcshare') | to_json }}

JWT_ACCESS_SECRET={{ vault_jwt_access_secret | to_json }}
JWT_REFRESH_SECRET={{ vault_jwt_refresh_secret | to_json }}
JWT_ACCESS_TTL={{ jwt_access_ttl | default(900) }}
JWT_REFRESH_TTL={{ jwt_refresh_ttl | default(1209600) }}
PASSWORD_RESET_TTL={{ password_reset_ttl | default(3600) }}

WEB_APP_URL={{ web_app_url | to_json }}
STORAGE_PUBLIC_BASE_URL={{ storage_public_base_url | to_json }}

# Object storage (Cloudflare R2)
STORAGE_DRIVER={{ storage_driver | default('r2') | to_json }}
STORAGE_UPLOAD_TTL={{ storage_upload_ttl | default(900) }}
R2_ENDPOINT={{ r2_endpoint | default('') | to_json }}
R2_ACCOUNT_ID={{ vault_r2_account_id | default('') | to_json }}
R2_ACCESS_KEY_ID={{ vault_r2_access_key_id | default('') | to_json }}
R2_SECRET_ACCESS_KEY={{ vault_r2_secret_access_key | default('') | to_json }}
R2_BUCKET={{ r2_bucket | default('') | to_json }}
R2_OBJECT_PREFIX={{ r2_object_prefix | default('abdcshare') | to_json }}

# Email (worker)
RESEND_API_KEY={{ vault_resend_api_key | default('') | to_json }}
EMAIL_FROM={{ email_from | to_json }}

# Seed profile only (first deploy; run manually — see docker-compose.stack.yml).
SEED_ADMIN_EMAIL={{ vault_seed_admin_email | default('') | to_json }}
SEED_ADMIN_PASSWORD={{ vault_seed_admin_password | default('') | to_json }}
