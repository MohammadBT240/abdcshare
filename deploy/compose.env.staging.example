# abdcshare staging stack variables — same VM as production, separate
# directory (/var/www/abdcshare/staging), separate compose project.
# Rendered as `.env` by Ansible; never commit a real .env.

COMPOSE_PROJECT_NAME=abdcshare-staging

REGISTRY_OWNER=mohammadbt240
IMAGE_TAG=latest

# Staging host ports (prod uses 4100/3100).
API_HOST_PORT=4101
WEB_HOST_PORT=3101

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://abdcshare:change-me@postgres:5432/abdcshare

JWT_ACCESS_SECRET=change-me-access-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
PASSWORD_RESET_TTL=3600

WEB_APP_URL=https://staging.abdcshare.com
STORAGE_PUBLIC_BASE_URL=https://staging-api.abdcshare.com

STORAGE_DRIVER=r2
STORAGE_UPLOAD_TTL=900
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=abdcshare-uploads-staging
R2_OBJECT_PREFIX=abdcshare

RESEND_API_KEY=
EMAIL_FROM="ABDC Share (staging) <no-reply@abdcshare.com>"

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
