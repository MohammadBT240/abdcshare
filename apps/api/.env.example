NODE_ENV=development
API_PORT=4000
API_GLOBAL_PREFIX=api
DATABASE_URL=postgresql://abdcshare:abdcshare@localhost:5432/abdcshare
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
PASSWORD_RESET_TTL=3600
SEED_ADMIN_EMAIL=admin@abdcshare.local
SEED_ADMIN_PASSWORD=ChangeMe!123

# Object storage — local (default) or r2 (requires all R2_* below)
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000
STORAGE_UPLOAD_TTL=900
LOCAL_STORAGE_DIR=./storage
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_OBJECT_PREFIX=abdcshare
# R2 bucket CORS must allow PUT (+ GET/HEAD) from web origins and ExposeHeaders: ETag.
# R2 lifecycle: abort incomplete multipart uploads after 7 days (bucket rule).
# Worker Office→PDF preview needs LibreOffice on PATH (soffice). Override with LIBREOFFICE_BIN.
