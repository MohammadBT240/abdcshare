# syntax=docker/dockerfile:1
# Build from repo root:
#   docker build -f deploy/Dockerfile.api -t abdcshare-api .
#
# The runner keeps dist/database/{setup,seed}.js so the same image serves as the
# one-shot migrate/seed container in deploy/docker-compose.stack.yml.

FROM node:22-bookworm-slim AS deps
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/api-client/package.json ./packages/api-client/
RUN corepack install
RUN pnpm install --frozen-lockfile --filter @abdcshare/api...

FROM deps AS builder
COPY tsconfig.base.json ./
COPY packages/config ./packages/config
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api
# Topological build: @abdcshare/shared (tsc) first, then the api (nest build).
RUN pnpm --filter @abdcshare/api... build

FROM node:22-bookworm-slim AS runner
WORKDIR /repo
ENV NODE_ENV=production
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/api-client/package.json ./packages/api-client/
RUN corepack install
RUN pnpm install --frozen-lockfile --prod --filter @abdcshare/api...
COPY --from=builder /repo/packages/shared/dist ./packages/shared/dist
COPY --from=builder /repo/apps/api/dist ./apps/api/dist
WORKDIR /repo/apps/api
EXPOSE 4000
CMD ["node", "dist/main.js"]
