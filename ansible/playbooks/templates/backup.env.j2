# Managed by Ansible (playbooks/backups.yml) — do not edit by hand.
BACKUP_NAME={{ backup_name }}
BACKUP_DEST=r2:{{ backup_r2_bucket }}
BACKUP_AGE_RECIPIENT={{ backup_age_recipient }}
BACKUP_KEEP_DAILY={{ backup_keep_daily | default(30) }}
BACKUP_KEEP_MONTHLY={{ backup_keep_monthly | default(12) }}
BACKUP_MAX_AGE_HOURS={{ backup_max_age_hours | default(26) }}
PG_DUMP_CMD=docker compose --project-directory {{ deploy_dir }} -f {{ deploy_dir }}/docker-compose.stack.yml exec -T postgres pg_dump -U abdcshare -Fc abdcshare
PSQL_CMD=docker compose --project-directory {{ deploy_dir }} -f {{ deploy_dir }}/docker-compose.stack.yml exec -T postgres psql -U abdcshare -d abdcshare
BACKUP_HEALTHCHECK_URL={{ vault_backup_healthcheck_url | default('') }}
BACKUP_ALERT_URL={{ vault_backup_alert_url | default('') }}
RCLONE_CONFIG_R2_TYPE=s3
RCLONE_CONFIG_R2_PROVIDER=Cloudflare
RCLONE_CONFIG_R2_ACCESS_KEY_ID={{ vault_backup_r2_access_key_id }}
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY={{ vault_backup_r2_secret_access_key }}
RCLONE_CONFIG_R2_ENDPOINT=https://{{ vault_r2_account_id }}.r2.cloudflarestorage.com
RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
