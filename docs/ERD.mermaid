erDiagram
    ROLE {
        int id PK
    }
    TITLE {
        int id PK
    }
    GENDER {
        int id PK
    }
    MARITAL_STATUS {
        int id PK
    }
    CLIENT_TYPE {
        int id PK
    }
    INDUSTRY {
        int id PK
    }
    CATEGORY {
        int id PK
    }
    BANK {
        int id PK
    }
    STATE {
        int id PK
    }
    LGA {
        int id PK
    }
    WARD {
        int id PK
    }
    ENGAGEMENT_TYPE {
        int id PK
    }
    FS_LINE {
        int id PK
    }
    REQUEST_TYPE {
        int id PK
    }
    REQUEST_STAGE {
        int id PK
    }
    REQUEST_STATUS {
        int id PK
    }
    DEPARTMENT {
        int id PK
    }
    USER {
        uuid id PK
        int role_id FK
        enum partner_designation
        int title_id FK
        int gender_id FK
        int marital_status_id FK
        int department_id FK
        uuid client_id FK
        varchar first_name
        varchar surname
        varchar email UK
    }
    REFRESH_TOKEN {
        uuid id PK
        uuid user_id FK
        varchar token_hash UK
        uuid family_id
    }
    PASSWORD_RESET_TOKEN {
        uuid id PK
        uuid user_id FK
        varchar token_hash UK
    }
    CLIENT {
        uuid id PK
        int client_type_id FK
        int industry_id FK
        int bank_id FK
        int state_id FK
        int lga_id FK
        int ward_id FK
        varchar name UK
    }
    ENGAGEMENT {
        uuid id PK
        uuid client_id FK
        int engagement_type_id FK
        int department_id FK
        varchar reference_code UK
        enum status
    }
    ENGAGEMENT_TEAM_MEMBER {
        uuid engagement_id PK, FK
        uuid user_id PK, FK
        enum member_role
    }
    ENGAGEMENT_FS_LINE {
        uuid engagement_id PK, FK
        int request_class_id PK, FK
    }
    FS_LINE_ENGAGEMENT_TYPE {
        int request_class_id PK, FK
        int engagement_type_id PK, FK
    }
    ENGAGEMENT_STATUS_HISTORY {
        uuid id PK
        uuid engagement_id FK
        uuid changed_by FK
    }
    ENGAGEMENT_SIGN_OFF {
        uuid id PK
        uuid engagement_id FK
        int request_class_id FK
        uuid signed_by FK
    }
    REQUEST {
        uuid id PK
        uuid engagement_id FK
        int request_type_id FK
        int stage_id FK
        int status_id FK
    }
    REQUEST_ASSIGNEE {
        uuid request_id PK, FK
        uuid user_id PK, FK
    }
    REQUEST_HISTORY {
        uuid id PK
        uuid request_id FK
        uuid actor_id FK
    }
    CLIENT_SUBMISSION {
        uuid id PK
        uuid request_id FK
        uuid submitted_by FK
        enum status
    }
    SUBMISSION_FILE {
        uuid id PK
        uuid submission_id FK
        varchar storage_key
    }
    DOCUMENT {
        uuid id PK
        uuid engagement_id FK
        int request_class_id FK
        uuid request_id FK
        int department_id FK
        enum category
        enum status
    }
    DOCUMENT_FILE {
        uuid id PK
        uuid document_id FK
        int version
        varchar storage_key
    }
    DOCUMENT_PARTICIPANT {
        uuid document_id PK, FK
        uuid user_id PK, FK
        enum participant_role
    }
    REVIEW {
        uuid id PK
        uuid request_id FK
        uuid document_id FK
        uuid preparer_id FK
        uuid reviewer_id FK
        enum status
    }
    DISCUSSION_MESSAGE {
        uuid id PK
        uuid request_id FK
        uuid author_id FK
        uuid parent_message_id FK
    }
    DISCUSSION_ATTACHMENT {
        uuid id PK
        uuid message_id FK
    }
    DISCUSSION_MENTION {
        uuid message_id PK, FK
        uuid mentioned_user_id PK, FK
    }
    DISCUSSION_READ {
        uuid request_id PK, FK
        uuid user_id PK, FK
    }
    NOTIFICATION {
        uuid id PK
        uuid user_id FK
        varchar entity_type
        uuid entity_id
        bool is_read
    }
    NOTIFICATION_PREFERENCE {
        uuid user_id PK, FK
        varchar notification_type PK
        bool email_enabled
        bool in_app_enabled
    }
    COMPANY_PROFILE_DOCUMENT {
        uuid id PK
        varchar name
        varchar storage_key
        varchar file_name
        bool is_active
        uuid created_by FK
    }
    ACTIVITY_LOG {
        uuid id PK
        uuid actor_id FK
        varchar entity_type
        uuid entity_id
    }
    OUTBOX {
        uuid id PK
        varchar event_type
        enum status
        int attempts
    }
    BULK_IMPORT_JOB {
        uuid id PK
        enum kind
        enum status
        uuid created_by FK
    }
    PARTNER_WEEKLY_REPORT {
        uuid id PK
        uuid partner_id FK
        date week_start_date
        enum status
        uuid reviewed_by FK
    }
    PARTNER_WEEKLY_REPORT_FILE {
        uuid id PK
        uuid report_id FK
    }

    ROLE ||--o{ USER : "role"
    TITLE ||--o{ USER : "title"
    GENDER ||--o{ USER : "gender"
    MARITAL_STATUS ||--o{ USER : "marital"
