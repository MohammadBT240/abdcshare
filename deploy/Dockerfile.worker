# syntax=docker/dockerfile:1
# Debian base so LibreOffice (soffice) can convert Office → PDF for in-app previews.
FROM node:22-bookworm-slim AS base
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-impress \
    libreoffice-calc \
    fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @abdcshare/worker... build
WORKDIR /repo/apps/worker
CMD ["node", "dist/main.js"]
