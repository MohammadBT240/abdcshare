NODE_ENV=development
DATABASE_URL=postgresql://abdcshare:abdcshare@localhost:5432/abdcshare
REDIS_URL=redis://localhost:6379
RESEND_API_KEY=
EMAIL_FROM="ABDC Share <no-reply@example.com>"
WEB_APP_URL=http://localhost:3000
# Must match apps/api STORAGE_DRIVER. If API uses r2 and worker stays local, previews ENOENT.
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:4000
LOCAL_STORAGE_DIR=../api/storage
# When STORAGE_DRIVER=r2, set the same R2_* values as the API:
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=abdcshare
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_OBJECT_PREFIX=abdcshare
# Office→PDF preview: install LibreOffice (`brew install --cask libreoffice`).
# LIBREOFFICE_BIN=/Applications/LibreOffice.app/Contents/MacOS/soffice
# Library virus scanning (S3): clamd INSTREAM. Required in production. Without it (dev only) files are
# hashed and marked Clean with a "not scanned" note. Local clamd: `docker run -p 3310:3310 clamav/clamav:1.4`.
# CLAMD_HOST=127.0.0.1
# CLAMD_PORT=3310
