# abdcshare production stack variables (deploy/docker-compose.stack.yml).
#
# On the VM this file is rendered as `.env` by Ansible from group_vars +
# Vault (ansible/playbooks/templates/env.j2). Never commit a real .env.
# In-stack hostnames (postgres, redis) — not localhost.

COMPOSE_PROJECT_NAME=abdcshare

# GHCR image coordinates (lowercase owner) + tag (git SHA, pinned by CI).
REGISTRY_OWNER=mohammadbt240
IMAGE_TAG=latest

# Host ports (proxied by the host nginx; bound to 127.0.0.1 only).
# Occupied on the shared VM: 3000/3001/3002/3003/8080/8081 (abdchub + QET).
API_HOST_PORT=4100
WEB_HOST_PORT=3100

# Postgres (in-stack container). Password must be URL-encoded inside DATABASE_URL.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://abdcshare:change-me@postgres:5432/abdcshare

# Auth
JWT_ACCESS_SECRET=change-me-access-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-min-32-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
PASSWORD_RESET_TTL=3600

# Public URLs
WEB_APP_URL=https://abdcshare.com
STORAGE_PUBLIC_BASE_URL=https://api.abdcshare.com

# Object storage — Cloudflare R2 in production.
STORAGE_DRIVER=r2
STORAGE_UPLOAD_TTL=900
R2_ENDPOINT=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=abdcshare-uploads
R2_OBJECT_PREFIX=abdcshare

# Email (worker)
RESEND_API_KEY=
EMAIL_FROM="ABDC Share <no-reply@abdcshare.com>"

# Seed profile only (first deploy, run manually — see docker-compose.stack.yml).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
