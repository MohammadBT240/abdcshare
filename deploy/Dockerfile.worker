# syntax=docker/dockerfile:1
# Build from repo root:
#   docker build -f deploy/Dockerfile.worker -t abdcshare-worker .
#
# Debian base so LibreOffice (soffice) can convert Office documents to PDF for
# in-app previews. LibreOffice is installed in the runner stage only.

FROM node:22-bookworm-slim AS deps
WORKDIR /repo
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/api-client/package.json ./packages/api-client/
RUN corepack install
RUN pnpm install --frozen-lockfile --filter @abdcshare/worker...

FROM deps AS builder
COPY tsconfig.base.json ./
COPY packages/config ./packages/config
COPY packages/shared ./packages/shared
COPY apps/worker ./apps/worker
RUN pnpm --filter @abdcshare/worker... build

FROM node:22-bookworm-slim AS runner
WORKDIR /repo
ENV NODE_ENV=production
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    libreoffice-writer \
    libreoffice-impress \
    libreoffice-calc \
    fonts-dejavu-core \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/config/package.json ./packages/config/
COPY packages/api-client/package.json ./packages/api-client/
RUN corepack install
RUN pnpm install --frozen-lockfile --prod --filter @abdcshare/worker...
COPY --from=builder /repo/packages/shared/dist ./packages/shared/dist
COPY --from=builder /repo/apps/worker/dist ./apps/worker/dist
WORKDIR /repo/apps/worker
CMD ["node", "dist/main.js"]
